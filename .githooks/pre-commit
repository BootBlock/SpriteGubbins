#!/usr/bin/env sh
#
# Sprite Gubbins pre-commit hook. Guards the three things that matter most on a PUBLIC repo,
# scoped to the STAGED changes so it stays fast:
#   (a) a credential-shaped scan of the staged diff (no secrets, ever — see CLAUDE.md);
#   (b) Prettier formatting on staged code files;
#   (c) ESLint on staged JS/TS/TSX files.
# Any failure aborts the commit. In a genuine emergency, bypass with `git commit --no-verify`.
#
# Auto-wired by the "prepare" npm script (sets core.hooksPath = .githooks) on `npm install`.
# It is a local first line of defence, not a guarantee — a --no-verify commit, or a clone that
# never ran `npm install`, skips it entirely. `npm run lint`, `npm run format:check` and
# `node scripts/secret-scan.ts --diff <base>` are the authoritative equivalents, and they are what
# the gate jobs in `.github/workflows/deploy.yml` run before a publish.

set -u

fail=0
red=''
reset=''
if [ -t 2 ]; then
  red="$(printf '\033[31m')"
  reset="$(printf '\033[0m')"
fi

note() { printf '%s\n' "$*" >&2; }
err() { printf '%spre-commit: %s%s\n' "$red" "$*" "$reset" >&2; }

# Staged files, everything but a deletion — a deletion can't introduce new content. Stated as an
# exclusion (git's lower case) rather than the allow-list `ACM` this used to be, for the reason
# `scripts/secret-scan.ts` gives: an allow-list omits whatever is not in it, and this one omitted
# `R`. Rename detection is on by default, so a `git mv` and an edit in one commit made the whole
# file a rename — and it was then checked by neither Prettier nor ESLint below.
staged="$(git diff --cached --name-only --diff-filter=d)"

# --- (a) Secret scan of the staged diff ------------------------------------------------
# The credential patterns live in one place — `scripts/secretScan.ts`, which `secret-scan.ts` and
# the CI job both call — so the hook and the publish gate cannot drift apart. The script scans only
# ADDED lines, drops a match that is an obvious placeholder, and exits non-zero (printing the
# suspect lines) if anything looks credential-shaped.
if ! node scripts/secret-scan.ts --staged; then
  note 'In a genuine emergency this check can be skipped with `git commit --no-verify`.'
  fail=1
fi

# --- (b) Prettier check on staged code files -------------------------------------------
# Prettier honours .prettierignore, so pass the staged code files and let it skip the rest.
prettier_files="$(printf '%s\n' "$staged" | grep -Ei '\.(m?[jt]sx?|cjs|css|json)$' || true)"
if [ -n "$prettier_files" ]; then
  if ! printf '%s\n' "$prettier_files" | xargs npx prettier --check; then
    err 'Prettier found unformatted staged files — run `npm run format` (or `npx prettier --write <files>`).'
    fail=1
  fi
fi

# --- (c) ESLint on staged JS/TS/TSX files ----------------------------------------------
# `--no-warn-ignored`: staged files under an ignore pattern (public/, dist/) are deliberately
# not linted, and warning about each one on every commit is pure noise.
eslint_files="$(printf '%s\n' "$staged" | grep -Ei '\.([jt]sx?|mjs|cjs)$' || true)"
if [ -n "$eslint_files" ]; then
  if ! printf '%s\n' "$eslint_files" | xargs npx eslint --no-warn-ignored; then
    err 'ESLint failed on staged files — fix the reported problems (or `npm run lint:fix`).'
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  note ''
  err 'commit aborted. Resolve the issues above and re-stage, or bypass with --no-verify.'
  exit 1
fi

exit 0
