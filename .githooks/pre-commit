#!/usr/bin/env sh
#
# Sprite Gubbins pre-commit hook. Guards the three things that matter most on a PUBLIC repo,
# scoped to the STAGED changes so it stays fast:
#   (a) a credential-shaped scan of the staged diff (no secrets, ever — see CLAUDE.md);
#   (b) Prettier formatting and ESLint, both judged on the staged copy of each file rather than
#       the working tree, so a partly staged file is judged on what the commit carries.
# Any failure aborts the commit. In a genuine emergency, bypass with `git commit --no-verify`.
#
# Auto-wired by the "prepare" npm script (sets core.hooksPath = .githooks) on `npm install`.
# It is a local first line of defence, not a guarantee — a --no-verify commit, or a clone that
# never ran `npm install`, skips it entirely. `npm run lint`, `npm run format:check` and
# `node scripts/secret-scan.ts` in its `--diff` and `--commits` modes are the authoritative
# equivalents, the second reading every pushed commit rather than the tip alone, and they are what
# the gate jobs in `.github/workflows/tests.yml` run on every push, to every branch, and again on
# the commit a deploy is about to publish. `main` requires those jobs, so a commit this hook waved
# through still has to pass them before it can land there.

set -u

fail=0
red=''
reset=''
if [ -t 2 ]; then
  red="$(printf '\033[31m')"
  reset="$(printf '\033[0m')"
fi

note() { printf '%s\n' "$*" >&2; }
err() { printf '%spre-commit: %s%s\n' "$red" "$*" "$reset" >&2; }

# --- (a) Secret scan of the staged diff ------------------------------------------------
# The credential patterns live in one place — `scripts/secretScan.ts`, which `secret-scan.ts` and
# the CI job both call — so the hook and the publish gate cannot drift apart. The script scans the
# ADDED lines of the staged diff, plus the whole staged blob of each file git calls binary (which
# contributes no lines to a diff — issue #211). It drops a match that is an obvious placeholder,
# and exits non-zero, printing what it found, if anything looks credential-shaped.
if ! node scripts/secret-scan.ts --staged; then
  note 'In a genuine emergency this check can be skipped with `git commit --no-verify`.'
  fail=1
fi

# --- (b) Prettier and ESLint on the staged copy of each file ----------------------------
# Both tools read the working tree when handed a path, so a file staged in part was judged on
# content the commit does not carry (issue #448). `scripts/staged-check.ts` reads each file's blob
# out of the index and gives that text to Prettier's and ESLint's APIs, and lets each tool decide
# which staged files are its business, as `format:check` and `lint` do in CI.
if ! node scripts/staged-check.ts; then
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  note ''
  err 'commit aborted. Resolve the issues above and re-stage, or bypass with --no-verify.'
  exit 1
fi

exit 0
