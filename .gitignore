# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules
.pnpm-store

# Build output
dist
dist-ssr
*.local

# Vite / tooling caches
.vite
*.tsbuildinfo

# Test / coverage
coverage
.nyc_output

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
