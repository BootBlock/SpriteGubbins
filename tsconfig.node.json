{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    /* `DOM` because a suite here drives the app's image utilities, which are written against
       `ImageData` — the tests run under happy-dom, which provides it. See
       `tests/sheet-scale-corpus.test.ts`, which measures the scale readings against the sheets in
       `test_sprites/`, and so needs the filesystem and the browser types in one program. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting / strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "types": ["node"]
  },
  /* The Vite config, the build-time helpers it imports, and the Node-side tests — the suites that
     read files on disk, whether what they assert on is the file itself (the design-token contract)
     or what the app makes of it (`sheet-scale-corpus.test.ts`, which measures the quantiser's scale
     readings against the sheets in `test_sprites/`). Reading the filesystem is what puts a suite
     here: `src/`'s program carries no Node types, deliberately, so a `node:fs` import anywhere under
     it fails the type-check. Every other test lives beside its source under `src/`.

     `scripts` is included as `*.ts` only: the standalone `.mjs` tools in there are run by node
     directly and are not part of any TypeScript program. */
  "include": ["vite.config.ts", "scripts/**/*.ts", "tests"]
}
